{
  "expo": {
    "name": "Factory dashboard",
    "slug": "yt-factory-dashboard",
    "version": "1.0.0",
    "scheme": "ytfdash",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Factory dashboard",
      "shortName": "Factory",
      "themeColor": "#15181c",
      "backgroundColor": "#15181c"
    },
    "experiments": {
      "baseUrl": "/yt-factory-dashboard",
      "typedRoutes": false
    },
    "plugins": [
      "expo-router"
    ]
  }
}